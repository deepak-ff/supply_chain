# ChainWarden local development environment
# Copy to .env and fill in values — never commit .env
#
# Quick setup: run `cwctl setup` to generate this file interactively.

# ── Dashboard authentication ──────────────────────────────────────────────
# Set these to enable login on the web dashboard (http://localhost:3000).
# Without them the dashboard runs in open-access dev mode (no login required).
CW_ADMIN_EMAIL=admin@example.com
CW_ADMIN_PASSWORD=changeme
CW_SESSION_SECRET=generate-a-random-64-char-hex-string

# ── Dynamic Trust Score ───────────────────────────────────────────────────
# Where per-package behavioural ledgers are stored. Default: ~/.chainwarden/trust
# Point this at a shared/committed directory to keep trust history with the repo.
#CW_TRUST_DIR=./.chainwarden/trust

# ── AI features ───────────────────────────────────────────────────────────
# Required for: cwctl advisory, cwctl patch, dashboard AI advisory
ANTHROPIC_API_KEY=sk-ant-...

# ── Docker-compose dev defaults ───────────────────────────────────────────
POSTGRES_PASSWORD=devpassword
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
GRAFANA_PASSWORD=admin
