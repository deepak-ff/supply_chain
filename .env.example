# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=your-secure-random-key-here-generate-with-secrets.token_hex(32)

# Database
DATABASE_URL=sqlite:///scbtss.db
# For PostgreSQL (Railway):
# DATABASE_URL=postgresql://user:password@host:port/database

# Monitoring Configuration
MONITOR_INTERVAL=60
BASELINE_INTERVAL=3600
SCORE_INTERVAL=300

# Logging
LOG_LEVEL=INFO

# Server
PORT=5000